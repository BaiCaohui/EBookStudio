<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EbookToolSuite.Core\EbookToolSuite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 迁移脚本内嵌为资源。显式 LogicalName 让 SchemaMigrator 能按
         EbookToolSuite.Infrastructure.Data.Migrations.<文件名> 精确取到。 -->
    <EmbeddedResource Include="Data\Migrations\*.sql">
      <LogicalName>EbookToolSuite.Infrastructure.Data.Migrations.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>