<Window x:Class="EbookToolSuite.App.Views.CbzImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览" Height="720" Width="980" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnWindowPreviewMouseWheel">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 抬头：第几张 / 共几张 + 包内条目名 -->
    <TextBlock x:Name="CaptionText" Grid.Row="0" Margin="2,0,2,8" FontSize="12"
               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

    <!-- 预览区故意是「灯箱」式的深色底：亮主题下看大图也不刺眼。
         这里用主题里的遮罩令牌（ScrimStrongBrush）而不是写死 #000000，
         深/浅/米黄各档主题切换时它会跟着变，不会出现白底白字。 -->
    <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True"
            Background="{DynamicResource ScrimStrongBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <Grid>
        <!-- 缩放靠显式设置 Image 的宽高（Stretch=Uniform 撑满这个框）：
             用 RenderTransform 缩放的话 ScrollViewer 算不到放大的尺寸，滚不出被裁掉的部分。 -->
        <ScrollViewer x:Name="ImageScroll" Background="Transparent"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnViewportSizeChanged">
          <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="Both"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>

        <!-- 解不了的格式（WebP 之类）在这里给一句人话，不留一块黑屏 -->
        <TextBlock x:Name="FallbackText" FontSize="13" LineHeight="22" MaxWidth="560"
                   TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource DangerForegroundBrush}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                 Foreground="{DynamicResource TextTertiaryBrush}" Text="缩放 100%" />
      <Button x:Name="FitButton" Content="适合窗口" Height="30" Padding="12,0"
              Click="OnFitClick" ToolTip="回到整张图都看得见的大小（滚轮可以放大缩小）" />
      <Button x:Name="CloseButton" Content="关闭（Esc）" Margin="8,0,0,0" Height="30" Padding="12,0"
              Click="OnCloseClick" ToolTip="关掉预览，回到编辑窗继续调顺序" />
    </StackPanel>
  </Grid>
</Window>
