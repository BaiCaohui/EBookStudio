<Window x:Class="EbookToolSuite.App.Views.ConversionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="转换日志" Height="520" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="BookText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
               Foreground="{DynamicResource TextPrimaryBrush}" />

    <!-- 原样显示 Calibre 的输出，不做任何美化：排障时原文最重要 -->
    <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True"
             AcceptsReturn="True" TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button x:Name="CopyButton" Content="复制全部"
              Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyClick" />
      <Button x:Name="CloseButton" IsCancel="True" Content="关闭" Margin="8,0,0,0"
              Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
