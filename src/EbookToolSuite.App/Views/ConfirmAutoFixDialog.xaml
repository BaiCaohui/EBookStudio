<Window x:Class="EbookToolSuite.App.Views.ConfirmAutoFixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动修正确认" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FocusManager.FocusedElement="{Binding ElementName=ConfirmButton}">
  <Grid Margin="20,18,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" MaxWidth="560"
               FontSize="16" LineHeight="24" />

    <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
            Background="{DynamicResource LayerBackgroundBrush}">
      <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Padding="10,8">
        <ItemsControl x:Name="FixList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                         Margin="0,0,0,6" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="560" FontSize="14"
               LineHeight="22"
               Text="确认后会先给这一章建一个还原点（备份修正前的原文），再写入工作区；想退回修正前，用备份中心里的这个还原点。点【取消】则一个字节都不改。" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}" Content="确认修改" Width="108" Height="34" FontSize="14"
              IsDefault="True" Click="OnConfirm" />
      <Button x:Name="CancelButton" Content="取消" Width="96" Height="34" FontSize="14"
              Margin="10,0,0,0" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>