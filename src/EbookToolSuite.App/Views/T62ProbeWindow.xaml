<Window x:Class="EbookToolSuite.App.Views.T62ProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EBookStudio - T6-2 PDF 探针"
        Height="900" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0"
                   Padding="10" TextWrapping="Wrap"
                   FontFamily="Consolas" FontSize="12"
                   Text="T6-2 探针：正在初始化 WebView2..." />

        <Grid Grid.Row="1">
            <!-- Web = 正式启动参数（含 msPdfOOUI 关闭）；Web2 = 对照环境（不关 msPdfOOUI），
                 只在探针 1 需要走"必须去掉 msPdfOOUI"的分支时启用。 -->
            <wv2:WebView2 x:Name="Web" />
            <wv2:WebView2 x:Name="Web2" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
