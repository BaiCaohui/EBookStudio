<Window x:Class="EbookToolSuite.App.Views.BookEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:EbookToolSuite.App.Converters"
        Title="{Binding WindowTitle}"
        Height="760" Width="1180" MinHeight="540" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" FocusManager.FocusedElement="{Binding ElementName=ConfirmSaveButton}">
  <Window.Resources>
    <!-- 页级资源不跨窗口共享（书库页那两个就在自己的 UserControl.Resources 里），
         所以这里必须自带一份，否则 InitializeComponent 会直接抛 XamlParseException。 -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

    <!-- 章节列表要跟书库主题走（用户 2026-10-21：深色主题下它还是白底白字，看不见）。
         WPF 的 ListBox/ListBoxItem 默认用系统白底 + 系统选中色，必须整份换成主题令牌，
         背景取 LayerBackgroundBrush —— 和右侧「书名/作者/语言」这些输入框同一个底。 -->
    <Style x:Key="ChapterListStyle" TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource LayerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="ChapterItemStyle" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bg" Margin="1" CornerRadius="4" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background"
                        Value="{DynamicResource SurfaceHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background"
                        Value="{DynamicResource AccentSurfaceBrush}" />
                <Setter TargetName="Bg" Property="BorderBrush"
                        Value="{DynamicResource AccentColorBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 抬头：书名（跟着输入实时变）+ 被编辑的文件 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="SemiBold"
                 TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="{Binding SourcePath, StringFormat=文件：{0}}" />
    </StackPanel>

    <Grid Grid.Row="1">
      <!-- 三块都按窗口伸缩：章节树与右侧信息栏是 *，封面是固定 240；
           两条 GridSplitter 让用户还能手动拖（左侧栏不再写死 300）。 -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" MinWidth="220" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="0.9*" MinWidth="250" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="2.2*" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource BorderSubtleBrush}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    ToolTip="拖动调整章节树的宽度" />

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource BorderSubtleBrush}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    ToolTip="拖动调整书籍信息区的宽度" />

      <!-- 最左：章节树（T5-1）。所有操作都只改工作区，点【保存】才写进书里。 -->
      <Grid Grid.Column="0" Margin="0,0,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
          <TextBlock Text="章节结构" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     Text="{Binding Chapters.Count, StringFormat=共 {0} 章}" />
        </StackPanel>

        <ListBox x:Name="ChapterList" Grid.Row="1" Margin="0,8,0,0"
                 Style="{StaticResource ChapterListStyle}"
                 ItemContainerStyle="{StaticResource ChapterItemStyle}"
                 ItemsSource="{Binding Chapters.Items}"
                 SelectedItem="{Binding Chapters.Selected, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="{Binding Indent}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding Position, StringFormat={}{0}.}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Hint}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock FontSize="11" Text="目录里没有这一章（标题按文件名显示）"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             Visibility="{Binding TitleFromFileName, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBox x:Name="ChapterTitleBox" Grid.Row="2" Margin="0,8,0,0"
                 Text="{Binding Chapters.NewTitle, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="重命名用；新增 / 导入时留空则用默认名字" />

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                     Text="拆分点（从这一块切开，后半章另存为新章）" />
          <ComboBox x:Name="ChapterSplitBox" Margin="0,4,0,0"
                    ItemsSource="{Binding Chapters.SplitPoints}"
                    SelectedItem="{Binding Chapters.SelectedSplitPoint, Mode=TwoWay}"
                    DisplayMemberPath="Display" />
        </StackPanel>

        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
          <Button x:Name="ChapterRenameButton" Content="重命名" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterRenameClick" />
          <Button x:Name="ChapterUpButton" Content="上移" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterUpClick" />
          <Button x:Name="ChapterDownButton" Content="下移" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterDownClick" />
          <Button x:Name="ChapterPromoteButton" Content="升一级" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterPromoteClick"
                  ToolTip="在目录里升一级：从父项里提出来，排在父项后面（正文与文件名都不动）" />
          <Button x:Name="ChapterDemoteButton" Content="降一级" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterDemoteClick"
                  ToolTip="在目录里降一级：挂到前一个同级条目底下（正文与文件名都不动）" />
          <Button x:Name="ChapterVisualButton" Content="可视编辑" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterVisualClick"
                  ToolTip="所见即所得地改这一章（文字/图片/表格），排版与图片按书里的样子显示" />
          <Button x:Name="ChapterSourceButton" Content="编辑源码" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterSourceClick"
                  ToolTip="打开选中章节的 XHTML 源码（AvalonEdit）：改完先存进工作区，语法不过关会被拦住" />
          <Button x:Name="ChapterScanButton" Content="资源检查" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnResourceScanClick"
                  ToolTip="扫描全书：引用了不存在的资源（悬空，红色）/ 没人引用的资源（孤儿，黄色）" />
          <Button x:Name="ChapterSplitButton" Content="拆分章节" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterSplitClick"
                  ToolTip="按上面的拆分点把这一章切成两章：前半留在原文件，后半写成新章节（正文内容不重排）" />
          <Button x:Name="ChapterMergeButton" Content="合并下一章" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterMergeClick" />
          <Button x:Name="ChapterDeleteButton" Content="删除" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterDeleteClick" />
          <Button x:Name="ChapterAddButton" Content="新增空章" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterAddClick" />
          <Button x:Name="ChapterImportButton" Content="导入文件..." Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterImportClick" />
          <Button x:Name="ChapterRevertButton" Content="回到会话开始" Margin="0,0,6,6"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnChapterRevertClick"
                  ToolTip="把章节结构恢复成刚打开这本书时的样子（原文件始终没动过）" />
        </WrapPanel>

        <TextBlock Grid.Row="5" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="{Binding Chapters.Status}" />
      </Grid>


      <!-- 左：封面 + 替换（设计文档 9.4.5：点封面看大图，预览里的「替换」才写；
           本次先只做「替换」这一条主路径，大图预览与移除留给后续） -->
      <StackPanel Grid.Column="2" Width="240" Margin="0,0,20,0">
        <Border Height="330" CornerRadius="4"
                Background="{DynamicResource LayerBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
          <Grid>
            <Image x:Name="CoverImage" Source="{Binding CoverPreview}" Stretch="Uniform" Margin="4" />
            <TextBlock Text="（没有封面）" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                       Visibility="{Binding HasCoverPreview, Converter={StaticResource InverseBoolToVis}}" />
          </Grid>
        </Border>

        <Button x:Name="ReplaceCoverButton" Margin="0,10,0,0" Content="替换封面..."
                Style="{StaticResource PrimaryButtonStyle}" Click="OnReplaceCoverClick"
                ToolTip="选一张 JPG / PNG / WebP，会自动裁到最大边 1600 的 JPEG 再写进书里" />

        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding CoverNote}" />
      </StackPanel>

      <!-- 右：元数据表单 -->
      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="68" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Text="书名" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                   Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Text="副标题" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <TextBox x:Name="SubtitleBox" Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsEpub3}" />
            <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="副标题是 EPUB3 的 refines 写法，EPUB2 里没有对应表示（这一项会被禁掉）"
                       Visibility="{Binding IsEpub2, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Text="作者" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <TextBox x:Name="AuthorsBox" Text="{Binding Authors, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="多个作者用「、」分隔（EPUB2 写 opf:role，EPUB3 写 refines）" />
          </StackPanel>

          <TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" Text="系列" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox x:Name="SeriesBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                   Text="{Binding Series, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right" Text="系列序号" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox x:Name="SeriesIndexBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                   Text="{Binding SeriesIndex, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="5" Grid.Column="0" HorizontalAlignment="Right" Text="语言" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox x:Name="LanguageBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                   Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right" Text="ISBN" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox x:Name="IsbnBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"
                   Text="{Binding Isbn, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="7" Grid.Column="0" HorizontalAlignment="Right" Text="出版社" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox x:Name="PublisherBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10"
                   Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="8" Grid.Column="0" HorizontalAlignment="Right" Text="出版日期" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
            <TextBox x:Name="PublicationDateBox"
                     Text="{Binding PublicationDate, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="格式：2024-05-01（留空 = 不写）" />
          </StackPanel>

          <TextBlock Grid.Row="9" Grid.Column="0" HorizontalAlignment="Right" Text="简介" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox x:Name="DescriptionBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,10"
                   Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="10" Grid.Column="0" HorizontalAlignment="Right" Text="标签" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,10">
            <TextBox x:Name="SubjectsBox" Text="{Binding Subjects, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="多个标签用「、」分隔" />
          </StackPanel>

          <TextBlock Grid.Row="11" Grid.Column="0" HorizontalAlignment="Right" Text="评分" Margin="0,0,8,10"
                     VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
          <!-- 6 个条目 = 0..5，SelectedIndex 直接绑 Rating（0 = 未评分）。
               注意：条目文字必须显式写出来曾经这 5 条写成 Content=""，
               下拉框里只有"未评分"一行有字，其余全是空白行。 -->
          <!-- 6 个条目 = 0..5，SelectedIndex 直接绑 Rating（0 = 未评分）。
               注意：这 6 条的 Content 必须都写出来。曾经后 5 条写成 Content=""，
               界面上只有"未评分"一行有字、其余全是空白行（用户报的 bug）。 -->
          <ComboBox x:Name="RatingBox" Grid.Row="11" Grid.Column="1" Width="140"
                    HorizontalAlignment="Left" Margin="0,0,0,10"
                    SelectedIndex="{Binding Rating, Mode=TwoWay}">
            <ComboBoxItem Content="未评分" />
            <ComboBoxItem Content="★" />
            <ComboBoxItem Content="★★" />
            <ComboBoxItem Content="★★★" />
            <ComboBoxItem Content="★★★★" />
            <ComboBoxItem Content="★★★★★" />
          </ComboBox>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- 校验面板（T3-5）：EpubCheck 说不行、或校验没跑成时出现在这里。
         故意不用模态弹窗：模态会把冒烟测试的自动化线程永远挂住（T3-UI 时实测踩过），
         而且「仍然保存（不推荐）」本来就是这一屏上的一个按钮，比弹窗更点得到。
         默认（危险的那个）不是默认按钮，用户要点两下才会走危险路径。 -->
    <Border x:Name="ValidationPanel" AutomationProperties.LiveSetting="Assertive" Grid.Row="2" Margin="0,14,0,0" Padding="12,10" CornerRadius="4"
            Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
            Visibility="{Binding ShowValidationPanel, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock x:Name="ValidationHeadlineText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}" Text="{Binding ValidationHeadline}" />
        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
          <TextBlock x:Name="ValidationDetailsText" FontSize="11" FontFamily="Consolas"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ValidationDetails}" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
          <Button x:Name="AutoFixButton" Margin="0,0,8,0" Content="一键修复（补全 manifest）"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnAutoFixClick"
                  Visibility="{Binding CanAutoFix, Converter={StaticResource BoolToVis}}"
                  ToolTip="把工作区里没在 manifest 声明的文件补进去，然后自动重新校验" />
          <Button x:Name="CancelSaveButton" IsCancel="True" Content="取消（不保存）"
                  Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelSaveClick" />
          <Button x:Name="ConfirmSaveButton" IsDefault="True" Margin="8,0,0,0" Content="{Binding ConfirmActionText}"
                  Style="{StaticResource PrimaryButtonStyle}" Click="OnConfirmSaveClick"
                  ToolTip="文件会被替换成校验没过的这一版，风险自负" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 状态条：把「正在做什么」说清楚，长任务不至于像卡死 -->
    <Border Grid.Row="3" Margin="0,14,0,0" Padding="10,7" CornerRadius="4"
            Background="{DynamicResource LayerBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <!-- T7-3：IsBusy 以前是死绑定（全仓没有 XAML 绑它），现在真正显示进度 -->
        <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="True">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButtonStyle}"
              Click="OnSaveClick"
              ToolTip="写回 OPF -> 打包 -> 结构自检 -> 原子替换原文件" />
      <Button x:Name="DiscardButton" Margin="8,0,0,0" Content="放弃修改并关闭"
              Style="{StaticResource SecondaryButtonStyle}" Click="OnDiscardClick"
              ToolTip="丢掉工作区里的所有改动并清理目录，原文件一个字节都不动" />
      <Button x:Name="CloseButton" Margin="8,0,0,0" Content="关闭"
              Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
