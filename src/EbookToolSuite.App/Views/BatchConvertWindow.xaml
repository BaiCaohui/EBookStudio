<Window x:Class="EbookToolSuite.App.Views.BatchConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量转换" Height="430" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" FocusManager.FocusedElement="{Binding ElementName=StartButton}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="20" FontWeight="SemiBold"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="目标格式" Margin="0,0,12,10"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="TargetCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                      SelectionChanged="OnTargetChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="转换模板" Margin="0,0,12,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="TemplateCombo" Grid.Row="1" Grid.Column="1" />
        </Grid>

        <Border Grid.Row="2" Padding="14" CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="HintText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="NoteText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick" />
            <Button x:Name="StartButton" IsDefault="True" Content="加入队列" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnStartClick" />
        </StackPanel>
    </Grid>
</Window>
