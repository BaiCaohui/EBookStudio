<Window x:Class="EbookToolSuite.App.Views.DuplicatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现重复" Height="440" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadlineText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="DetailText" Grid.Row="1" Margin="0,8,0,0"
               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

    <ListView x:Name="ItemList" Grid.Row="2" Margin="0,12,0,0">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="文件" Width="300" DisplayMemberBinding="{Binding File}" />
          <GridViewColumn Header="情况" Width="280" DisplayMemberBinding="{Binding Detail}" />
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Margin="0,0,0,0" x:Name="ReplaceAllButton" Content="替换" MinWidth="110" Height="30"
                        Click="OnReplaceAllClick" ToolTip="用新导入的文件替换库里已有的那本（同一本书只留一本）" />
                    <Button Margin="8,0,0,0" x:Name="SkipAllButton" Content="跳过全部重复" MinWidth="130" Height="30"
              IsDefault="True" Click="OnSkipAllClick" />
      <Button x:Name="ImportAllButton" Content="全部都导入" MinWidth="110" Height="30"
              Margin="8,0,0,0" Click="OnImportAllClick" />
      <Button x:Name="EachButton" IsCancel="True" Content="逐项决定" MinWidth="100" Height="30"
              Margin="8,0,0,0" Click="OnEachClick" />
    </StackPanel>
  </Grid>
</Window>