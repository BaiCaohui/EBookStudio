<Window x:Class="EbookToolSuite.App.Views.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="转换格式" Height="620" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" FocusManager.FocusedElement="{Binding ElementName=StartButton}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 抬头：书名 + 现有格式 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="BookTitleText" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="BookFormatsText" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 表单 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="源格式" Margin="0,0,12,10"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="SourceCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                      SelectionChanged="OnSourceChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="目标格式" Margin="0,0,12,10"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="TargetCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                      SelectionChanged="OnTargetChanged" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="转换模板" Margin="0,0,12,10"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="TemplateCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                      SelectionChanged="OnTemplateChanged" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="输出位置" Margin="0,0,12,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="OutputPathText" Grid.Row="3" Grid.Column="1"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <!-- 模板说明 + 高级参数 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock x:Name="TemplateNoteText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Expander x:Name="AdvancedExpander" Header="高级参数（可选，谨慎使用）"
                      Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,6"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="每行写一个参数，例如：--base-font-size 20。参数会先过 Calibre 白名单，不被支持的一律拒绝执行。" />
                    <TextBox x:Name="AdvancedBox" AcceptsReturn="True" Height="72"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- 提示条：这个窗口不再自己跑转换，只负责把任务排进队列 -->
        <Border Grid.Row="3" Padding="14" CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <TextBlock x:Name="HintText" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="点「加入队列」后任务会排进转换队列，进度与结果在左侧「转换队列」页查看。" />
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="SaveAsTemplateButton" Content="另存为模板"
                    Style="{StaticResource SecondaryButtonStyle}" Click="OnSaveAsTemplateClick" />
            <Button x:Name="DeleteTemplateButton" Content="删除模板" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="OnDeleteTemplateClick" />
            <Button x:Name="CancelButton" IsCancel="True" Content="取消" Margin="24,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick" />
            <Button x:Name="StartButton" IsDefault="True" Content="加入队列" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnStartClick" />
        </StackPanel>
    </Grid>
</Window>
