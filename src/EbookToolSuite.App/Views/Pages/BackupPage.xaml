<UserControl x:Class="EbookToolSuite.App.Views.Pages.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EbookToolSuite.App.Controls">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="PruneButton" Content="清理超限备份" Click="OnPruneClick"
                Style="{StaticResource SecondaryButtonStyle}" />
        <Button x:Name="RestoreButton" Content="还原选中的还原点" Click="OnRestoreClick"
                IsEnabled="False" Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock x:Name="SubtitleText" Text="正在读取还原点" FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <ListView x:Name="PointList" Visibility="Collapsed"
                SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding When}" />
            <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding Kind}" />
            <GridViewColumn Header="书" Width="260" DisplayMemberBinding="{Binding Book}" />
            <GridViewColumn Header="文件" Width="260" DisplayMemberBinding="{Binding File}" />
            <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding Size}" />
          </GridView>
        </ListView.View>
      </ListView>

      <c:EmptyState x:Name="EmptyView" Visibility="Collapsed"
                    IconGlyph="{StaticResource IconGlyphBackup}"
                    Title="还没有还原点"
                    Body="每次保存书籍时都会自动建一个（放在 Data/Backup/RestorePoints 下），想退回旧版本时回到这一页点「还原」即可。" />

      <c:LoadingState x:Name="LoadingView" Visibility="Collapsed"
                      Text="正在读取还原点…" />

      <c:ErrorState x:Name="ErrorView" Visibility="Collapsed"
                    Title="还原点读不出来" />
    </Grid>
  </Grid>
</UserControl>
