<UserControl x:Class="EbookToolSuite.App.Views.Pages.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EbookToolSuite.App.Controls">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SubtitleText" Grid.Row="0" FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Text="导入、编辑保存、还原与备份清理的历史记录。" />

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <ListView x:Name="BatchList" Visibility="Collapsed"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding When}" />
            <GridViewColumn Header="来源" Width="320" DisplayMemberBinding="{Binding Source}" />
            <GridViewColumn Header="结果" Width="220" DisplayMemberBinding="{Binding Result}" />
            <GridViewColumn Header="备注" Width="260" DisplayMemberBinding="{Binding Note}" />
          </GridView>
        </ListView.View>
      </ListView>

      <c:EmptyState x:Name="EmptyView" Visibility="Collapsed"
                    IconGlyph="{StaticResource IconGlyphActivity}"
                    Title="还没有记录"
                    Body="导入、编辑保存、还原与备份清理都会在这里留一行。" />

      <c:LoadingState x:Name="LoadingView" Visibility="Collapsed"
                      Text="正在读取活动记录…" />

      <c:ErrorState x:Name="ErrorView" Visibility="Collapsed"
                    Title="活动记录读不出来" />
    </Grid>
  </Grid>
</UserControl>
