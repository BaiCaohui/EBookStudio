<Window x:Class="EbookToolSuite.App.Views.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="阅读"
        Width="1024" Height="820"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True">

  <!-- 阅读窗口是独立顶层窗口，不是页面：读书是长时间活动，
       不该被书库页的导航切走。里面只有 WebView2 一件东西，
       工具栏在 reader.html 里（这样它和正文同源、可直接操作 iframe）。 -->
  <Grid>
    <wv2:WebView2 x:Name="Web" />

    <!-- T6-1：MOBI/AZW3 首次打开要在后台转 EPUB，可能好几秒，必须先给反馈。
         覆盖层显示时把 WebView2 收起（WPF 的 HWND 控件有层级问题，压不住）。 -->
    <Border x:Name="BusyPanel" Visibility="Collapsed" Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.97">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="BusyText"
                   Text="正在准备这本书"
                   FontSize="16"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- T6-1 判据 4：转换失败时明确提示 + 「用系统默认程序打开」按钮 -->
    <Border x:Name="ErrorPanel" AutomationProperties.LiveSetting="Assertive" Visibility="Collapsed" Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.97">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <TextBlock x:Name="ErrorText"
                   TextWrapping="Wrap"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <Button x:Name="OpenExternalButton"
                Content="用系统默认程序打开"
                Margin="0,16,0,0"
                Padding="14,6"
                HorizontalAlignment="Center"
                Click="OnOpenExternalClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>