<Window x:Class="EbookToolSuite.App.Views.DuplicateScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重复检测"
        Height="660" Width="920"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=ScanButton}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="疑似重复的书" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.75"
                       Text="按书名、作者、格式分组，再对候选算全文件哈希确证。合并只是把多余的那几本标为副本并从书库隐藏，文件一个都不删。"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding Suggestion}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBlock Text="{Binding CountText}" Opacity="0.75"/>
                                    <TextBlock Text=" / " Opacity="0.5"/>
                                    <TextBlock Text="{Binding SizeText}" Opacity="0.75"/>
                                    <TextBlock Text=" / " Opacity="0.5"/>
                                    <TextBlock Text="{Binding HashVerdict}" Opacity="0.75"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FormatText}" Margin="10,0,0,0" Opacity="0.75" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="10,0,0,0" Opacity="0.75" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AddedText}" Margin="10,0,0,0" Opacity="0.75" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding HashText}" Margin="10,0,0,0" Opacity="0.6" VerticalAlignment="Center"/>
                                                <Button Grid.Column="5" Content="保留这本" Margin="12,0,0,0" Height="26" Padding="10,0"
                                                        Command="{Binding DataContext.KeepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="忽略这组" HorizontalAlignment="Left" Margin="0,8,0,0" Height="26" Padding="10,0"
                                        Command="{Binding IgnoreCommand}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ScanButton" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Content="开始扫描" Click="OnScanClick" Height="32" Padding="16,0"/>
            <Button x:Name="CloseButton" IsCancel="True" Content="关闭" Click="OnCloseClick" Height="32" Padding="16,0" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
