<UserControl x:Class="EbookToolSuite.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <!-- 空状态 / 占位页的统一样子。规格见设计文档 9.9.12。 -->
  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">

      <TextBlock Style="{StaticResource HeroIconStyle}"
                 HorizontalAlignment="Center"
                 Text="{Binding IconGlyph, ElementName=Root}" />

      <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center"
                 FontSize="20" FontWeight="SemiBold"
                 TextAlignment="Center" TextWrapping="Wrap"
                 Text="{Binding Title, ElementName=Root}"
                 Foreground="{DynamicResource TextPrimaryBrush}" />

      <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                 FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                 Text="{Binding Body, ElementName=Root}"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

      <Border Margin="0,20,0,0" HorizontalAlignment="Center"
              CornerRadius="10" Padding="10,4"
              Background="{DynamicResource SurfaceHoverBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Badge, ElementName=Root}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Badge, ElementName=Root}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock FontSize="12"
                   Text="{Binding Badge, ElementName=Root}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Border>

      <!-- 追加内容槽：设置页的两个可用按钮、书库空状态的导入按钮 -->
      <ContentPresenter Margin="0,20,0,0" HorizontalAlignment="Center"
                        Content="{Binding Extra, ElementName=Root}" />
    </StackPanel>
  </Grid>
</UserControl>