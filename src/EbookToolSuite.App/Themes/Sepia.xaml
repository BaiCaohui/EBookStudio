<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    米黄主题（用户 2026-10-21 要求）。key 与 Colors.xaml / Dark.xaml / Green.xaml 完全一致，运行时整份替换。
    配色对齐阅读器现有的「米黄」一档（reader.js 的 sepia 主题：
    #F4ECD8 底 / #5B4636 字 / #8B5A2B 强调），保证主程序与阅读器观感一致。
    米黄只能手动选，不随系统切换。
  -->

  <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="#FFF0E6CF" />
  <SolidColorBrush x:Key="LayerBackgroundBrush"     Color="#FFF7EFDD" />
  <SolidColorBrush x:Key="CardBackgroundBrush"      Color="#FFFAF4E6" />
  <SolidColorBrush x:Key="BorderSubtleBrush"        Color="#FFDCCFB0" />

  <SolidColorBrush x:Key="TextPrimaryBrush"         Color="#FF5B4636" />
  <SolidColorBrush x:Key="TextSecondaryBrush"       Color="#FF7A6A55" />
  <SolidColorBrush x:Key="TextTertiaryBrush"        Color="#FF9C8B72" />

  <SolidColorBrush x:Key="AccentColorBrush"         Color="#FF8B5A2B" />
  <SolidColorBrush x:Key="AccentSurfaceBrush"       Color="#1F8B5A2B" />
  <SolidColorBrush x:Key="AccentSurfaceHoverBrush"  Color="#298B5A2B" />

  <SolidColorBrush x:Key="SurfaceHoverBrush"        Color="#0F5B4636" />
  <SolidColorBrush x:Key="SurfacePressedBrush"      Color="#175B4636" />

  <SolidColorBrush x:Key="DangerBackgroundBrush"    Color="#FFC62828" />
  <SolidColorBrush x:Key="DangerForegroundBrush"    Color="#FFFFFFFF" />
  <!-- 米黄底比纯白稍深，红字直接用浅色档的 #FFC62828 仍然清楚。 -->
  <SolidColorBrush x:Key="DangerTextBrush"          Color="#FFB3261E" />
  <SolidColorBrush x:Key="SuccessBrush"             Color="#FF2D6A2D" />
  <SolidColorBrush x:Key="NeutralBrush"             Color="#FF9C8B72" />
  <SolidColorBrush x:Key="FileMissingBrush"         Color="#FF6E6E6E" />
  <SolidColorBrush x:Key="FileModifiedBrush"        Color="#FF9A5B00" />

  <SolidColorBrush x:Key="OnDangerBorderBrush"      Color="#66FFFFFF" />
  <SolidColorBrush x:Key="OnDangerHoverBrush"       Color="#26FFFFFF" />

  <!-- T7-3 新增语义色：警告横幅 / 信息块。四套主题各一份，禁止再写死 #FFF4E5 这类浅色 -->
  <SolidColorBrush x:Key="WarningBrush"             Color="#FF9A5B00" />
  <SolidColorBrush x:Key="WarningSurfaceBrush"      Color="#FFFBF1DC" />
  <SolidColorBrush x:Key="InfoBrush"                Color="#FF8B5A2B" />
  <!-- 覆盖层遮罩：各主题共用同一组半透明黑（叠在内容上，跟主题无关） -->
  <SolidColorBrush x:Key="ScrimBrush"       Color="#66000000" />
  <SolidColorBrush x:Key="ScrimStrongBrush" Color="#CC000000" />
</ResourceDictionary>
