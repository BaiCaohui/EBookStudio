<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    护眼主题（T7-3）。key 与 Colors.xaml / Dark.xaml 完全一致，运行时整份替换。
    底色与强调色刻意对齐阅读器现有的「护眼绿」一档（reader.js 的 green 主题：
    #CCE8CF 底 / #22361F 字 / #2D5A27 强调），保证主程序与阅读器观感一致。
    护眼只能手动选，不随系统切换。
  -->

  <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="#FFEDF3E7" />
  <SolidColorBrush x:Key="LayerBackgroundBrush"     Color="#FFF7FAF2" />
  <SolidColorBrush x:Key="CardBackgroundBrush"      Color="#FFFBFDF7" />
  <SolidColorBrush x:Key="BorderSubtleBrush"        Color="#FFC6D8BE" />

  <SolidColorBrush x:Key="TextPrimaryBrush"         Color="#FF22361F" />
  <SolidColorBrush x:Key="TextSecondaryBrush"       Color="#FF4A5D44" />
  <SolidColorBrush x:Key="TextTertiaryBrush"        Color="#FF7A8C72" />

  <SolidColorBrush x:Key="AccentColorBrush"         Color="#FF2D5A27" />
  <SolidColorBrush x:Key="AccentSurfaceBrush"       Color="#1F2D5A27" />
  <SolidColorBrush x:Key="AccentSurfaceHoverBrush"  Color="#292D5A27" />

  <SolidColorBrush x:Key="SurfaceHoverBrush"        Color="#0F22361F" />
  <SolidColorBrush x:Key="SurfacePressedBrush"      Color="#1722361F" />

  <SolidColorBrush x:Key="DangerBackgroundBrush"    Color="#FFB3261E" />
  <SolidColorBrush x:Key="DangerForegroundBrush"    Color="#FFFFFFFF" />
  <!-- 危险语义的文字色（TXT 编辑器查找计数）。 -->
  <SolidColorBrush x:Key="DangerTextBrush"          Color="#FFB3261E" />
  <SolidColorBrush x:Key="SuccessBrush"             Color="#FF2D6A2D" />
  <SolidColorBrush x:Key="NeutralBrush"             Color="#FF7A8C72" />
  <SolidColorBrush x:Key="FileMissingBrush"         Color="#FF6E6E6E" />
  <SolidColorBrush x:Key="FileModifiedBrush"        Color="#FF9A5B00" />

  <SolidColorBrush x:Key="OnDangerBorderBrush"      Color="#66FFFFFF" />
  <SolidColorBrush x:Key="OnDangerHoverBrush"       Color="#26FFFFFF" />

  <!-- T7-3 新增语义色：警告横幅 / 信息块。四套主题各一份，禁止再写死 #FFF4E5 这类浅色 -->
  <SolidColorBrush x:Key="WarningBrush"             Color="#FF9A5B00" />
  <SolidColorBrush x:Key="WarningSurfaceBrush"      Color="#FFFCF1DC" />
  <SolidColorBrush x:Key="InfoBrush"                Color="#FF2D5A27" />
  <!-- 覆盖层遮罩：四套主题共用同一组半透明黑（叠在内容上，跟主题无关） -->
  <SolidColorBrush x:Key="ScrimBrush"       Color="#66000000" />
  <SolidColorBrush x:Key="ScrimStrongBrush" Color="#CC000000" />
</ResourceDictionary>
