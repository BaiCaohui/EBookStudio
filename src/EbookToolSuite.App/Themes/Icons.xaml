<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    图标。规格见设计文档 9.9.4。
    字体 Segoe Fluent Icons 是 Windows 11 内置，字形码位集中在 NavIcons.cs，
    开工时已用 GlyphTypeface.CharacterToGlyphMap 逐个实测存在（不靠记忆）。
    T7-3：页面里不许再出现 &#xExxx; 字面量，统一用下面这些 key（UI 令牌）。
  -->

  <!-- 页面可直接引用的字形（T7-3 收口，值与 NavIcons.cs 一致） -->
  <sys:String x:Key="IconGlyphSearch">&#xE721;</sys:String>
  <sys:String x:Key="IconGlyphClear">&#xE711;</sys:String>
  <sys:String x:Key="IconGlyphCheck">&#xE73E;</sys:String>
  <sys:String x:Key="IconGlyphChevronDown">&#xE70D;</sys:String>
  <sys:String x:Key="IconGlyphChevronRight">&#xE76C;</sys:String>
  <sys:String x:Key="IconGlyphFolder">&#xE8B7;</sys:String>
  <sys:String x:Key="IconGlyphWarning">&#xE7BA;</sys:String>
  <sys:String x:Key="IconGlyphInfo">&#xE946;</sys:String>
  <sys:String x:Key="IconGlyphQueue">&#xE895;</sys:String>
  <sys:String x:Key="IconGlyphActivity">&#xE81C;</sys:String>
  <sys:String x:Key="IconGlyphStats">&#xE9D2;</sys:String>
  <sys:String x:Key="IconGlyphBackup">&#xE9D5;</sys:String>
  <sys:String x:Key="IconGlyphDocument">&#xE9F9;</sys:String>

  <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons</FontFamily>

  <!-- 导航项图标：20px，跟随前景色 -->
  <Style x:Key="NavIconStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- 行高锁死，避免不同字形把行高撑开导致图标上下跳动 -->
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- 内联小图标（横幅、卡片标题用） -->
  <Style x:Key="InlineIconStyle" TargetType="TextBlock" BasedOn="{StaticResource NavIconStyle}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <!-- 空状态的大图标：48px -->
  <Style x:Key="HeroIconStyle" TargetType="TextBlock" BasedOn="{StaticResource NavIconStyle}">
    <Setter Property="FontSize" Value="48" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="LineHeight" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
</ResourceDictionary>