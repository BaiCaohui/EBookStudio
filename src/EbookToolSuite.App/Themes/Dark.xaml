<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    深色主题。key 与 Colors.xaml 完全一致，运行时整份替换。
    T1-3a 只做"启动时读一次系统设置"，不做运行时热切换（那是 T7-3）。
  -->

  <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="#FF202020" />
  <SolidColorBrush x:Key="LayerBackgroundBrush"     Color="#FF2B2B2B" />
  <SolidColorBrush x:Key="CardBackgroundBrush"      Color="#FF2D2D2D" />
  <SolidColorBrush x:Key="BorderSubtleBrush"        Color="#FF3A3A3A" />

  <SolidColorBrush x:Key="TextPrimaryBrush"         Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush"       Color="#FFC5C5C5" />
  <SolidColorBrush x:Key="TextTertiaryBrush"        Color="#FF9A9A9A" />

  <SolidColorBrush x:Key="AccentColorBrush"         Color="#FF4CC2FF" />
  <SolidColorBrush x:Key="AccentSurfaceBrush"       Color="#1F4CC2FF" />
  <SolidColorBrush x:Key="AccentSurfaceHoverBrush"  Color="#294CC2FF" />

  <SolidColorBrush x:Key="SurfaceHoverBrush"        Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SurfacePressedBrush"      Color="#1AFFFFFF" />

  <SolidColorBrush x:Key="DangerBackgroundBrush"    Color="#FFC62828" />
  <SolidColorBrush x:Key="DangerForegroundBrush"    Color="#FFFFFFFF" />
  <!-- 深色底上的红字要提亮一档，否则读不清（TXT 编辑器查找计数）。 -->
  <SolidColorBrush x:Key="DangerTextBrush"          Color="#FFFF7B72" />
  <SolidColorBrush x:Key="SuccessBrush"             Color="#FF6CCB5F" />
  <SolidColorBrush x:Key="NeutralBrush"             Color="#FF9A9A9A" />
  <!-- T2-6 文件状态角标：缺失 / 被外部修改。两套主题用同一组颜色（白字，语义色不该随主题变浅） -->
  <SolidColorBrush x:Key="FileMissingBrush"        Color="#FF6E6E6E" />
  <SolidColorBrush x:Key="FileModifiedBrush"       Color="#FFB45309" />

  <SolidColorBrush x:Key="OnDangerBorderBrush"      Color="#66FFFFFF" />
  <SolidColorBrush x:Key="OnDangerHoverBrush"       Color="#26FFFFFF" />

  <!-- T7-3 新增语义色：警告横幅 / 信息块。四套主题各一份，禁止再写死 #FFF4E5 这类浅色 -->
  <SolidColorBrush x:Key="WarningBrush"             Color="#FFE8A33D" />
  <SolidColorBrush x:Key="WarningSurfaceBrush"      Color="#FF3A2E1B" />
  <SolidColorBrush x:Key="InfoBrush"                Color="#FF4CC2FF" />
  <!-- 覆盖层遮罩：四套主题共用同一组半透明黑（叠在内容上，跟主题无关） -->
  <SolidColorBrush x:Key="ScrimBrush"       Color="#66000000" />
  <SolidColorBrush x:Key="ScrimStrongBrush" Color="#CC000000" />
</ResourceDictionary>